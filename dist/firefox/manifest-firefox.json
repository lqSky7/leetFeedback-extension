{
    "manifest_version": 3,
    "name": "Traverse",
    "version": "1.5.2",
    "description": "Chrome extension for Traverse Ecosystem",
    "icons": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "tabs"
    ],
    "host_permissions": [
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://practice.geeksforgeeks.org/*",
        "https://*.takeuforward.org/*",
        "https://*.codechef.com/*",
        "https://api.github.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://traverse-backend-api.azurewebsites.net/*",
        "https://leet-feedback.vercel.app/*",
        "https://*.vercel.app/*",
        "https://*.netlify.app/*",
        "https://g4f.space/*"
    ],
    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.leetcode.com/*"
            ],
            "js": [
                "utils/common.js",
                "utils/github-api.js",
                "utils/gemini-api.js",
                "utils/backend-api.js",
                "utils/problem-timer.js",
                "utils/toast.js",
                "content-scripts/leetcode.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.geeksforgeeks.org/*",
                "https://practice.geeksforgeeks.org/*"
            ],
            "js": [
                "utils/common.js",
                "utils/github-api.js",
                "utils/gemini-api.js",
                "utils/backend-api.js",
                "utils/problem-timer.js",
                "utils/toast.js",
                "content-scripts/geeksforgeeks.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.takeuforward.org/*"
            ],
            "js": [
                "utils/common.js",
                "utils/github-api.js",
                "utils/gemini-api.js",
                "utils/backend-api.js",
                "utils/problem-timer.js",
                "utils/toast.js",
                "content-scripts/takeuforward.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.codechef.com/*"
            ],
            "js": [
                "utils/common.js",
                "utils/github-api.js",
                "utils/gemini-api.js",
                "utils/backend-api.js",
                "utils/problem-timer.js",
                "utils/toast.js",
                "content-scripts/codechef.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "utils/interceptor.js",
                "utils/monaco-bridge.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
   
        "action": {
        "default_title": "Open LeetFeedback",
        "default_popup": "sidepanel/sidepanel.html",
        "default_icon": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
        }
    },
        "browser_specific_settings": {
        "gecko": {
        "id": "traverse@fire.com",
        "strict_min_version": "113.0"
        }
    }
}