{
    "manifest_version": 3,
    "name": "Traverse",
    "version": "1.9.2",
    "description": "Chrome extension for Traverse Ecosystem",
    "icons": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "tabs",
        "sidePanel"
    ],
    "host_permissions": [
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://practice.geeksforgeeks.org/*",
        "https://*.takeuforward.org/*",
        "https://*.codechef.com/*",
        "https://*.naukri.com/*",
        "https://api.github.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://*.ngrok-free.dev/*",
        "https://traverse-backend.duckdns.org/*",
        "https://alfa-leetcode-api.onrender.com/*",
        "https://leet-feedback.vercel.app/*",
        "https://*.vercel.app/*",
        "https://traverses.tech/*",
        "https://*.traverses.tech/*",
        "https://*.netlify.app/*",
        "https://g4f.space/*",
        "https://chromewebstore.google.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "externally_connectable": {
        "matches": [
            "https://traverses.tech/*",
            "https://*.traverses.tech/*",
            "https://leet-feedback.vercel.app/*",
            "https://*.vercel.app/*",
            "http://localhost:5173/*",
            "http://localhost:3000/*"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.leetcode.com/*"
            ],
            "js": [
                "utils/common.js",
                "utils/github-api.js",
                "utils/gemini-api.js",
                "utils/backend-api.js",
                "utils/problem-timer.js",
                "utils/toast.js",
                "utils/hint-prompt.js",
                "content-scripts/leetcode.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.geeksforgeeks.org/*",
                "https://practice.geeksforgeeks.org/*"
            ],
            "js": [
                "utils/common.js",
                "utils/github-api.js",
                "utils/gemini-api.js",
                "utils/backend-api.js",
                "utils/problem-timer.js",
                "utils/toast.js",
                "utils/hint-prompt.js",
                "content-scripts/geeksforgeeks.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.takeuforward.org/*"
            ],
            "js": [
                "utils/common.js",
                "utils/github-api.js",
                "utils/gemini-api.js",
                "utils/backend-api.js",
                "utils/problem-timer.js",
                "utils/toast.js",
                "utils/hint-prompt.js",
                "content-scripts/takeuforward.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.codechef.com/*"
            ],
            "js": [
                "utils/common.js",
                "utils/github-api.js",
                "utils/gemini-api.js",
                "utils/backend-api.js",
                "utils/problem-timer.js",
                "utils/toast.js",
                "utils/hint-prompt.js",
                "content-scripts/codechef.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.naukri.com/*"
            ],
            "js": [
                "utils/common.js",
                "utils/github-api.js",
                "utils/gemini-api.js",
                "utils/backend-api.js",
                "utils/problem-timer.js",
                "utils/toast.js",
                "utils/hint-prompt.js",
                "content-scripts/naukri.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://traverses.tech/*",
                "https://*.traverses.tech/*",
                "https://leet-feedback.vercel.app/*",
                "http://localhost:5173/*",
                "http://localhost:3000/*"
            ],
            "js": [
                "content-scripts/website-sync.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_title": "Open LeetFeedback",
        "default_icon": {
            "16": "icons/16.png",
            "48": "icons/48.png",
            "128": "icons/128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "utils/interceptor.js",
                "utils/monaco-bridge.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
