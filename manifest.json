{
    "manifest_version": 3,
    "name": "Traverse",
    "version": "2.0.0",
    "description": "Chrome extension for Traverse Ecosystem",
    "icons": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "tabs",
        "sidePanel"
    ],
    "host_permissions": [
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://practice.geeksforgeeks.org/*",
        "https://*.takeuforward.org/*",
        "https://*.codechef.com/*",
        "https://*.naukri.com/*",
        "https://api.github.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://*.ngrok-free.dev/*",
        "https://traverse-backend.duckdns.org/*",
        "https://leet-feedback.vercel.app/*",
        "https://*.vercel.app/*",
        "https://traverses.tech/*",
        "https://*.traverses.tech/*",
        "https://*.netlify.app/*",
        "https://g4f.space/*",
        "https://chromewebstore.google.com/*"
    ],
    "background": {
        "service_worker": "background/background.js"
    },
    "externally_connectable": {
        "matches": [
            "https://traverses.tech/*",
            "https://*.traverses.tech/*",
            "https://leet-feedback.vercel.app/*",
            "https://*.vercel.app/*",
            "http://localhost:5173/*",
            "http://localhost:3000/*"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.leetcode.com/*"
            ],
            "js": [
                "page/net-interceptor.js",
                "page/monaco-bridge.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://*.leetcode.com/*"
            ],
            "js": [
                "core/config.js",
                "core/logger.js",
                "core/util.js",
                "core/net-protocol.js",
                "core/net-bridge.js",
                "core/ai-config.js",
                "core/session-store.js",
                "core/attempt-tracker.js",
                "core/backend-api.js",
                "core/github-api.js",
                "core/submission-pipeline.js",
                "core/problem-timer.js",
                "ui/toast.js",
                "ui/hint-prompt.js",
                "core/platform-adapter.js",
                "platforms/leetcode.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.geeksforgeeks.org/*",
                "https://practice.geeksforgeeks.org/*"
            ],
            "js": [
                "page/net-interceptor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://*.geeksforgeeks.org/*",
                "https://practice.geeksforgeeks.org/*"
            ],
            "js": [
                "core/config.js",
                "core/logger.js",
                "core/util.js",
                "core/net-protocol.js",
                "core/net-bridge.js",
                "core/ai-config.js",
                "core/session-store.js",
                "core/attempt-tracker.js",
                "core/backend-api.js",
                "core/github-api.js",
                "core/submission-pipeline.js",
                "core/problem-timer.js",
                "ui/toast.js",
                "ui/hint-prompt.js",
                "core/platform-adapter.js",
                "platforms/geeksforgeeks.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.takeuforward.org/*"
            ],
            "js": [
                "page/net-interceptor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://*.takeuforward.org/*"
            ],
            "js": [
                "core/config.js",
                "core/logger.js",
                "core/util.js",
                "core/net-protocol.js",
                "core/net-bridge.js",
                "core/ai-config.js",
                "core/session-store.js",
                "core/attempt-tracker.js",
                "core/backend-api.js",
                "core/github-api.js",
                "core/submission-pipeline.js",
                "core/problem-timer.js",
                "ui/toast.js",
                "ui/hint-prompt.js",
                "core/platform-adapter.js",
                "platforms/takeuforward.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.codechef.com/*"
            ],
            "js": [
                "page/net-interceptor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://*.codechef.com/*"
            ],
            "js": [
                "core/config.js",
                "core/logger.js",
                "core/util.js",
                "core/net-protocol.js",
                "core/net-bridge.js",
                "core/ai-config.js",
                "core/session-store.js",
                "core/attempt-tracker.js",
                "core/backend-api.js",
                "core/github-api.js",
                "core/submission-pipeline.js",
                "core/problem-timer.js",
                "ui/toast.js",
                "ui/hint-prompt.js",
                "core/platform-adapter.js",
                "platforms/codechef.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://*.naukri.com/*"
            ],
            "js": [
                "page/net-interceptor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://*.naukri.com/*"
            ],
            "js": [
                "core/config.js",
                "core/logger.js",
                "core/util.js",
                "core/net-protocol.js",
                "core/net-bridge.js",
                "core/ai-config.js",
                "core/session-store.js",
                "core/attempt-tracker.js",
                "core/backend-api.js",
                "core/github-api.js",
                "core/submission-pipeline.js",
                "core/problem-timer.js",
                "ui/toast.js",
                "ui/hint-prompt.js",
                "core/platform-adapter.js",
                "platforms/naukri.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://traverses.tech/*",
                "https://*.traverses.tech/*",
                "https://leet-feedback.vercel.app/*",
                "http://localhost:5173/*",
                "http://localhost:3000/*"
            ],
            "js": [
                "core/config.js",
                "core/logger.js",
                "platforms/website-sync.js"
            ],
            "run_at": "document_end"
        }
    ],
    "action": {
        "default_title": "Open LeetFeedback",
        "default_icon": {
            "16": "icons/16.png",
            "48": "icons/48.png",
            "128": "icons/128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    }
}
